    "COMPRENSORI_INSTANCE": "User id=COMPRENSORI_PROD; Password=comprensoriprod29072013; Data Source=PITRE_EXA_T;",
    "COMUNETN_INSTANCE": "User id=COMUNETN_PROD; Password=comunetnprod02082013; Data Source=PITRE_EXA_T;Pooling=true; Min Pool Size=10; Connection Lifetime=600;",
    "COMUNI_INSTANCE": "User id=COMUNI_PROD; Password=comuniprod24072013; Data Source=PITRE_EXA_T;",
    "CONS_COMUNI_INSTANCE": "User id=CONS_COMUNI_PROD; Password=conscomuni09082013; Data Source=PITRE_EXA_T;",
    "ENTI_INSTANCE": "User id=ENTI_PROD; Password=entiprod07082013; Data Source=PITRE_EXA_T;",
