{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\Pi3\\Pi3.App.Interop.WebApi\\Logs.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] ({EventId} or {Properties:j}) {Message:lj}{NewLine}{Exception}",
          "retainedFileCountLimit": 10,
          "shared": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "Pi3.App.Interop.WebApi"
    }
  },
  "OracleDbContextFactoryServiceOptions": {
    "EnableLogging": false
  },
  "SuperadminUserOptions": {
    "UserId": "ADMINISTRATOR"
  },
  "InfrastructureAACOptions": {
    "UrlJWK": "https://aac-test.cloud-test.tndigit.it/jwk"
  },
  "AddressBookOptions": {
    "Url": "https://pitre-test.cloud-test-intra.tndigit.it/rubricacomunelegacy/api/v1"
  },
  "InteroperabilityServiceOptions": {
    "Url": "https://localhost:7159/api/v1"
  }
}
