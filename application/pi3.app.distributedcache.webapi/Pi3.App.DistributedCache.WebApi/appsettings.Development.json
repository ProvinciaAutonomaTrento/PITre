{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\Pi3\\Pi3.App.DistributedCache.WebApi\\Logs.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] ({EventId} or {Properties:j}) {Message:lj}{NewLine}{Exception}",
          "retainedFileCountLimit": 10,
          "shared": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "Pi3.App.DistributedCache.WebApi"
    }
  },
  "BasicAuthServiceOptions": {
    "UserName": "CacheUser",
    "Password": "ckGCOCx0hltfEqDtS"
  },
  "RedisOptions": {
    "ConnectionString": "localhost:6379"
  }
}
